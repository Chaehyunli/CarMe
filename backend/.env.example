APP_ENV=local
APP_NAME=CarMe API
API_V1_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc
FRONTEND_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql+psycopg://carme:carme_local_password@localhost:5432/carme
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=carme-private
S3_REGION=ap-northeast-2
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_local_password

KAKAO_REST_API_KEY=
# 카카오 개발자 콘솔에 등록하는 backend callback URL
KAKAO_REDIRECT_URI=http://localhost:8000/api/v1/auth/kakao/callback
# backend가 인증 완료 뒤 redirect할 frontend 경로
FRONTEND_LOGIN_CALLBACK_URL=http://localhost:5173/auth/callback
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# 기본 로컬 모델. Qwen3:8b와 qwen3-embedding:4b는 최초 1회 직접 pull한다.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_DIMENSIONS=1024
# OpenAI 호환 provider를 실험할 때만 채운다.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
EMBEDDING_MODEL_NAME=qwen3-embedding:4b
CHAT_SESSION_IDLE_TTL_MINUTES=30
