APP_ENV=local
APP_NAME=CarMe API
API_V1_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc
FRONTEND_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql+psycopg://carme:carme_local_password@localhost:55432/carme
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=carme-private
S3_REGION=ap-northeast-2
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_local_password

KAKAO_REST_API_KEY=
# 카카오 REST API 키의 클라이언트 시크릿을 켠 경우에만 채운다.
KAKAO_CLIENT_SECRET=
# 카카오 개발자 콘솔에 등록하는 backend callback URL
KAKAO_REDIRECT_URI=http://localhost:8000/api/v1/auth/kakao/callback
# backend가 인증 완료 뒤 redirect할 frontend 경로
FRONTEND_LOGIN_CALLBACK_URL=http://localhost:5173/auth/callback
# 비워두면 관리자 역할 선택을 허용하지 않는다. 운영 값은 절대 커밋하지 않는다.
ADMIN_SIGNUP_CODE=
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
UPLOAD_URL_TTL_SECONDS=300

# 기본 로컬 모델. Qwen3:8b와 qwen3-embedding:4b는 최초 1회 직접 pull한다.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_DIMENSIONS=2560
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=240
# OpenAI 호환 provider를 실험할 때만 채운다.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
EMBEDDING_MODEL_NAME=qwen3-embedding:4b
CHAT_SESSION_IDLE_TTL_MINUTES=30
CHAT_ANSWER_TIMEOUT_SECONDS=25

# 질문 의도·검색어 확장만 같은 로컬 Qwen에 짧게 요청한다.
# 비우면 OLLAMA_CHAT_MODEL을 재사용하며, 모델 지연/실패 시 규칙 폴백으로 계속 검색한다.
RAG_INTENT_LLM_ENABLED=true
RAG_INTENT_MODEL=
RAG_INTENT_TIMEOUT_SECONDS=4
RAG_INTENT_HISTORY_TURNS=4
RAG_VECTOR_CANDIDATES=24
RAG_SEMANTIC_SCORE_WEIGHT=3.0

# 현대 공식 웹 매뉴얼(Pleos, 경고등 등) 발견·동기화용. 답변은 저장된 공식 원문만 인용한다.
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
OFFICIAL_SOURCE_SYNC_TIMEOUT_SECONDS=30
